:8080 {
	encode zstd gzip
	request_body {
		max_size 130MB
	}
	@backend path /api/* /health
	handle @backend {
		reverse_proxy 127.0.0.1:8000 {
			flush_interval -1
			transport http {
				read_timeout 300s
				write_timeout 300s
			}
		}
	}
	handle {
		reverse_proxy 127.0.0.1:3000
	}
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
