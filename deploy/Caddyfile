{$SITE_ADDRESS::80} {
	encode zstd gzip
	request_body {
		max_size 130MB
	}
	@backend path /api/* /health
	handle @backend {
		reverse_proxy backend:8000 {
			flush_interval -1
			transport http {
				read_timeout 300s
				write_timeout 300s
			}
		}
	}
	handle {
		reverse_proxy frontend:3000
	}
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
